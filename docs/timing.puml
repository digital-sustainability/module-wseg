@startuml
<style>
timingDiagram {
  .red {
    LineColor red
    LineThickness 3
  }
}
</style>

Title WSEG-Semesterablauf
hide time-axis
footer: "https://github.com/digital-sustainability/module-wseg/blob/26/hs/docs/timing.puml"
caption CC-BY-4.0

legend
IW:\t\tIteration Wrap-Up
Linie:\tLernpfad Studierende
Termine:\tchronologisch ohne Feiertage
end legend

concise "Termine FS26" as module
concise "Iterationen" as iter
robust "Themen" as studi <<red>>
concise "Vorbereitungsaufträge" as prep
concise "Dozierende" as dozent
scale 1 as 90 pixels

@0
studi is EINSCHREIBUNG
dozent is "Unterstützung / Coaching / ..."
prep is "individuell"

@+1
module is "1"
iter is "0"
prep is "Literaturstudium / Videos / Fragen"
studi is "Onboarding & GRUPPEN"

@+1
module is "2"
studi is "Kollaboration"

@+1
iter is "1"
module is "3"
studi is "Technologie(n)"

@+1
module is "4"
studi is "Architektur(en)"

@+1
module is "5"
iter is "2"
studi is "Agilität / Validierung"

@+1
module is "6"

@+1
module is "7"
prep is {-}

@+1
module is "8"
iter is "3"
studi is "KI / UX"

@+1
module is "9"

@+1
module is "10"

@+1
module is "11"
iter is "4"
studi is "Automatisierung"

@+1
module is "12"

@+1
module is "13"
studi is "Projektabschluss & RETROSPEKTIVE"

@+1
module is "( 14 )"
iter is "Abgabefrist"

@+1
module is {-}
iter is {-}

@+1
module is Prüfungsvorbereitung

@+1

@+1
module -> studi: Open Book\nPrüfung
module is {-}
dozent is {-}

highlight 2.5 to 3 #palegreen : Pitch
highlight 4.5 to 5 #lightgreen : IW
highlight 7.5 to 8 #lightgreen : IW
highlight 10.5 to 11 #lightgreen : IW
highlight 12.5 to 13 #palegreen : Präsentation

@enduml